  <!-- JavaScript Application Logic -->
  <script>
    // State Management
    let currentRole = 'Student'; // 'Student' or 'Professor'
    let selectedStep1Role = 'Student';
    let isLoggedIn = false;

    // Search Index Data
    const searchDatabase = [
      { type: 'Workshop', title: 'Workshop 1: Research Fundamentals', category: 'Workshops' },
      { type: 'Workshop', title: 'Workshop 2: Research Design', category: 'Workshops' },
      { type: 'Workshop', title: 'Workshop 3: Data Collection', category: 'Workshops' },
      { type: 'PPT', title: 'Sampling Methods PPT', category: 'Workshop 2' },
      { type: 'Template', title: 'Sampling Template File', category: 'Workshop 2' },
      { type: 'Video', title: 'Sampling Method Video Lecture', category: 'Workshop 2' },
      { type: 'Q&A', title: 'What sampling method should we use for small populations?', category: 'Help Desk' }
    ];

    // Panda Status Presets
    const pandaStates = [
      { badge: 'Sleeping', title: '"Nothing left to do."', sub: 'All current requirements completed.', emoji: '🐼💤' },
      { badge: 'Awake', title: '"There\'s still work to do."', sub: 'Pending activities exist, but deadline is not immediate.', emoji: '🐼' },
      { badge: 'Alert', title: '"Better finish this soon!"', sub: 'Activity deadline is near (under 24 hours).', emoji: '🐼👁️' },
      { badge: 'Overdue', title: '"Oh no, something is overdue!"', sub: 'Delayed activity detected in workspace.', emoji: '🐼😭' }
    ];
    let pandaIndex = 1;

    // Initialize Lucide Icons
    document.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
    });

    // Login Flow
    function selectRole(role) {
      selectedStep1Role = role;
      document.getElementById('selected-role-badge').innerText = role;
      document.getElementById('login-step-1').classList.add('hidden');
      document.getElementById('login-step-2').classList.remove('hidden');
    }

    function backToStep1() {
      document.getElementById('login-step-2').classList.add('hidden');
      document.getElementById('login-step-1').classList.remove('hidden');
    }

    function fillDemo(type) {
      if (type === 'student') {
        selectRole('Student');
        document.getElementById('login-email').value = 'studentname@tua.edu.ph';
        document.getElementById('login-password').value = 'password123';
      } else {
        selectRole('Professor');
        document.getElementById('login-email').value = 'professor@tua.edu.ph';
        document.getElementById('login-password').value = 'password123';
      }
    }

    function togglePasswordVisibility() {
      const pwdInput = document.getElementById('login-password');
      if (pwdInput.type === 'password') {
        pwdInput.type = 'text';
      } else {
        pwdInput.type = 'password';
      }
    }

    function handleLogin(e) {
      e.preventDefault();
      const email = document.getElementById('login-email').value.trim();
      
      // Domain validation check
      if (!email.endsWith('@tua.edu.ph') && !email.includes('tua')) {
        showErrorModal('Invalid Domain', 'Please use your official school email address (@tua.edu.ph).');
        return;
      }

      // Role verification check logic
      const isStudentEmail = email.toLowerCase().includes('student');
      const isProfEmail = email.toLowerCase().includes('prof');

      if (selectedStep1Role === 'Professor' && isStudentEmail) {
        showErrorModal('Unable to Log In', 'This account is registered as a Student. Please select "Student" to continue.');
        return;
      }

      if (selectedStep1Role === 'Student' && isProfEmail) {
        showErrorModal('Incorrect Account Type', 'This account is registered as a Professor. Please select "Professor" to continue.');
        return;
      }

      // Successful Login setup
      currentRole = selectedStep1Role;
      isLoggedIn = true;

      // Update User Interface according to role
      document.getElementById('auth-screen').classList.add('hidden');
      document.getElementById('user-display-role').innerText = currentRole + ' Account';
      document.getElementById('user-display-name').innerText = currentRole === 'Student' ? 'Group 4' : 'Dr. Santos (Faculty)';

      // STRICT ROLE ACCESS CONTROL
      const profNavBtn = document.getElementById('nav-prof-dashboard');
      if (currentRole === 'Professor') {
        profNavBtn.classList.remove('hidden');
        switchTab('prof-dashboard');
      } else {
        profNavBtn.classList.add('hidden');
        switchTab('student-dashboard');
      }
    }

    function showErrorModal(title, msg) {
      document.getElementById('error-modal-title').innerText = title;
      document.getElementById('error-modal-msg').innerText = msg;
      document.getElementById('error-modal').classList.remove('hidden');
    }

    function closeErrorModal() {
      document.getElementById('error-modal').classList.add('hidden');
    }

    function logout() {
      isLoggedIn = false;
      document.getElementById('auth-screen').classList.remove('hidden');
      backToStep1();
    }

    // Navigation & View Switching
    function switchTab(tabId) {
      // Role Guard Verification
      if (tabId === 'prof-dashboard' && currentRole !== 'Professor') {
        alert('Access Restricted: Student accounts cannot access the Professor Dashboard.');
        return;
      }

      // Hide all views
      document.getElementById('view-student-dashboard').classList.add('hidden');
      document.getElementById('view-directory').classList.add('hidden');
      document.getElementById('view-tracker').classList.add('hidden');
      document.getElementById('view-prof-dashboard').classList.add('hidden');

      // Reset Nav Styles
      const navBtns = document.querySelectorAll('#app-nav button');
      navBtns.forEach(btn => btn.className = 'px-3 py-1.5 rounded-md hover:bg-blue-800/60 text-blue-100');

      // Show targeted view
      if (tabId === 'student-dashboard') {
        document.getElementById('view-student-dashboard').classList.remove('hidden');
        document.getElementById('nav-student-dashboard').className = 'px-3 py-1.5 rounded-md bg-blue-800 text-white font-bold';
      } else if (tabId === 'directory') {
        document.getElementById('view-directory').classList.remove('hidden');
        document.getElementById('nav-directory').className = 'px-3 py-1.5 rounded-md bg-blue-800 text-white font-bold';
      } else if (tabId === 'tracker') {
        document.getElementById('view-tracker').classList.remove('hidden');
        document.getElementById('nav-tracker').className = 'px-3 py-1.5 rounded-md bg-blue-800 text-white font-bold';
      } else if (tabId === 'prof-dashboard') {
        document.getElementById('view-prof-dashboard').classList.remove('hidden');
        document.getElementById('nav-prof-dashboard').className = 'px-3 py-1.5 rounded-md bg-tua-gold text-tua-blue font-bold';
      }
    }

    // Global Search Functionality
    function handleGlobalSearch(e) {
      const query = e.target.value.toLowerCase().trim();
      const resultsBox = document.getElementById('search-results-box');
      const content = document.getElementById('search-results-content');

      if (!query) {
        resultsBox.classList.add('hidden');
        return;
      }

      const matches = searchDatabase.filter(item => 
        item.title.toLowerCase().includes(query) || 
        item.type.toLowerCase().includes(query) ||
        item.category.toLowerCase().includes(query)
      );

      if (matches.length === 0) {
        content.innerHTML = `<p class="p-3 text-slate-400 text-center">No results found for "${query}"</p>`;
      } else {
        content.innerHTML = matches.map(m => `
          <div onclick="alert('Navigating to: ${m.title}') text-left" class="p-2 hover:bg-slate-100 rounded cursor-pointer border-b border-slate-100 last:border-none">
            <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase bg-blue-100 text-tua-blue">${m.type}</span>
            <p class="font-bold text-slate-800 mt-0.5">${m.title}</p>
            <p class="text-[10px] text-slate-400">${m.category}</p>
          </div>
        `).join('');
      }

      resultsBox.classList.remove('hidden');
    }

    // Google Calendar Action
    function addToGoogleCalendar() {
      const eventTitle = encodeURIComponent("Research Sync - Activity 3 Deadline");
      const details = encodeURIComponent("Submit Workshop 3 Activity 3 on the Research Hub.");
      const googleCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${eventTitle}&details=${details}`;
      window.open(googleCalUrl, '_blank');
    }

    // Panda Demo Cycle Toggler
    function cyclePandaDemo() {
      pandaIndex = (pandaIndex + 1) % pandaStates.length;
      const state = pandaStates[pandaIndex];
      document.getElementById('panda-badge').innerText = state.badge;
      document.getElementById('panda-avatar-box').innerText = state.emoji;
      document.getElementById('panda-status-title').innerText = state.title;
      document.getElementById('panda-status-sub').innerText = state.sub;
    }

    // Workshop Modal Functions
    function openWorkshopDetail(num) {
      document.getElementById('workshop-modal').classList.remove('hidden');
    }

    function closeWorkshopModal() {
      document.getElementById('workshop-modal').classList.add('hidden');
    }

    // Announcement Modal Functions
    function openAnnouncementModal(title, body) {
      document.getElementById('ann-modal-title').innerText = title;
      document.getElementById('ann-modal-body').innerText = body;
      document.getElementById('announcement-modal').classList.remove('hidden');
    }

    function closeAnnouncementModal() {
      document.getElementById('announcement-modal').classList.add('hidden');
    }
  </script>
